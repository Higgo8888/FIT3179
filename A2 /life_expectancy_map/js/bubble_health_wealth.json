{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 500,
  "title": {
    "text": "Health Expenditure vs Life Expectancy by Region",
    "subtitle": "Bubble size represents CO₂ emissions, colored by geographic region",
    "fontSize": 24,
    "subtitleFontSize": 14,
    "color": "#000000",
    "subtitleColor": "#7f8c8d",
    "anchor": "start",
    "offset": 25
  },
  "data": {
    "url": "https://raw.githubusercontent.com/Higgo8888/FIT3179/refs/heads/main/A2%20/life%20expectancy.csv"
  },
  "params": [
    {
      "name": "Region_selection",
      "value": null,
      "bind": {
        "input": "select",
        "options": [
          null,
          "South Asia",
          "Sub-Saharan Africa",
          "Europe & Central Asia",
          "Middle East & North Africa",
          "Latin America & Caribbean",
          "East Asia & Pacific",
          "North America"
        ],
        "labels": [
          "All Regions",
          "South Asia",
          "Sub-Saharan Africa",
          "Europe & Central Asia",
          "Middle East & North Africa",
          "Latin America & Caribbean",
          "East Asia & Pacific",
          "North America"
        ],
        "name": "Filter by Region: "
      }
    },
    {
      "name": "Year_selection",
      "value": 2019,
      "bind": {
        "input": "range",
        "min": 2001,
        "max": 2019,
        "step": 1,
        "name": "Select Year: "
      }
    },
    
    {
      "name": "CO2_above",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 500000,
        "step": 10000,
        "name": "Minimum CO₂ : "
      }
    }
  ],
  "transform": [
    {"filter": "datum.Year == Year_selection"},
    {
      "filter": "Region_selection == null || datum.Region == Region_selection"
    },
    {
      "filter": "datum['CO2'] >= CO2_above"
    }
  ],
  "encoding": {
    "x": {
      "field": "Health Expenditure %",
      "type": "quantitative",
      "title": "Health Expenditure (% of GDP)",
      "scale": {"domain": [0, 18]},
      "axis": {
        "titleColor": "#000000",
        "labelColor": "#000000",
        "titleFontSize": 14,
        "labelFontSize": 12,
        "gridColor": "#ecf0f1",
        "tickColor": "#bdc3c7"
      }
    },
    "y": {
      "field": "Life Expectancy World Bank",
      "type": "quantitative",
      "title": "Life Expectancy (Years)",
      "scale": {"domain": [40, 90]},
      "axis": {
        "titleColor": "#0000000",
        "labelColor": "#000000",
        "titleFontSize": 14,
        "labelFontSize": 12,
        "gridColor": "#ecf0f1",
        "tickColor": "#bdc3c7"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "opacity": 0.6,
        "stroke": "white",
        "strokeWidth": 0.9,
        "strokeOpacity": 0.6
      },
      "transform": [
        {"filter": "datum['Life Expectancy World Bank'] != null && datum['Life Expectancy World Bank'] > 0"},
        {"filter": "datum['Health Expenditure %'] != null && datum['Health Expenditure %'] > 0"},
        {"filter": "datum['CO2'] != null && datum['CO2'] > 0"},
        {"filter": "datum['Health Expenditure %'] <= 18"}
      ],
      "encoding": {
        "size": {
          "field": "CO2",
          "type": "quantitative",
          "title": "CO₂ Emissions (kt)",
          "scale": {
            "type": "log",
            "domain": [100, 1000, 10000, 100000, 5000000, 10000000],
            "range": [30, 80, 200, 500, 1200, 2500]
          },
          "legend": {
            "title": "CO₂ Emissions (kt)",
            "format": ".1s",
            "titleColor": "#000000",
            "labelColor": "#000000",
            "orient": "right",
            "direction": "vertical",
            "gradientLength": 200
          }
        },
        "color": {
          "field": "Region",
          "type": "nominal",
          "title": "Geographic Region",
          "scale": {
            "domain": [
              "South Asia",
              "Sub-Saharan Africa",
              "Europe & Central Asia",
              "Middle East & North Africa",
              "Latin America & Caribbean",
              "East Asia & Pacific",
              "North America"
            ],
            "range": [
              "#e74c3c",  
              "#9b59b6",  
              "#3498db",  
              "#2ecc71",  
              "#f39c12",  
              "#e67e22",  
              "#2c3e50"   
            ]
          },
          "legend": {
            "titleColor": "#000000",
            "labelColor": "#000000",
            "orient": "right",
            "direction": "vertical",
            "columns": 1,
            "symbolSize": 120
          }
        },
        "tooltip": [
          {"field": "Country Name", "type": "nominal", "title": "Country"},
          {"field": "Life Expectancy World Bank", "type": "quantitative", "title": "Life Expectancy (Years)", "format": ".1f"},
          {"field": "Health Expenditure %", "type": "quantitative", "title": "Health Expenditure %", "format": ".1f"},
          {"field": "CO2", "type": "quantitative", "title": "CO₂ Emissions (t)", "format": ",.0f"},
          {"field": "Region", "type": "nominal", "title": "Region"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -15,
        "fontSize": 11,
        "fontStyle": "italic"
      },
      "encoding": {
        "text": {"field": "Country Name", "type": "nominal"},
        "opacity": {
          "condition": {
            "test": "datum['Country Name'] == 'China' || datum['Country Name'] == 'United States of America' || datum['Country Name'] == 'Australia' || datum['Country Name'] == 'Japan' || datum['Country Name'] == 'Brazil' || datum['Country Name'] == 'United Kingdom'",
            "value": 1
          },
          "value": 0
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": "transparent"
    },
    "title": {
      "anchor": "start",
      "offset": 30
    },
    "legend": {
      "orient": "right",
      "labelLimit": 180,
      "titleFontSize": 13,
      "labelFontSize": 12,
      "offset": 10
    },
    "axis": {
      "labelFontSize": 11,
      "titleFontSize": 13,
      "domainColor": "#bdc3c7",
      "domainWidth": 1
    }
  }
}