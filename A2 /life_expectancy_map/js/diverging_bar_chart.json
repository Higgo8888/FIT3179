{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 600,
  "title": {
    "text": "Life Expectancy vs Regional Average",
    "subtitle": "Countries performing above or below their regional average with income group filtering",
    "fontSize": 25,
    "font": "Merriweather",
    "subtitleFont": "Open Sans",
    "subtitleFontSize": 14,
    "color": "#2c3e50",
    "subtitleColor": "#7f8c8d",
    "anchor": "start",
    "offset": 20
  },
  "params": [
    {
      "name": "Region_selection",
      "value": "East Asia & Pacific",
      "bind": {
        "input": "select",
        "options": ["South Asia", "Sub-Saharan Africa", "Europe & Central Asia", "Middle East & North Africa", "Latin America & Caribbean", "East Asia & Pacific", "North America"],
        "name": "Select Region: "
      }
    },
    {
      "name": "IncomeGroup_filter",
      "value": null,
      "bind": {
        "input": "select",
        "options": [null, "Low income", "Lower middle income", "Upper middle income", "High income"],
        "labels": ["All Income Groups", "Low income", "Lower middle income", "Upper middle income", "High income"],
        "name": "Filter by Income Group: "
      }
    },
    {
      "name": "Year_selection",
      "value": 2019,
      "bind": {
        "input": "range",
        "min": 2001,
        "max": 2019,
        "step": 1,
        "name": "Select Year: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Higgo8888/FIT3179/refs/heads/main/A2%20/life_expectancy_with_coordinates.csv"
      },
      "transform": [
        {"filter": "datum.Year == Year_selection"},
        {"filter": "datum.Region == Region_selection"},
        {"filter": "datum['Life Expectancy World Bank'] != null && datum['Life Expectancy World Bank'] > 0"},
        {"filter": "IncomeGroup_filter === null || datum.IncomeGroup == IncomeGroup_filter"},
        {
          "joinaggregate": [
            {"op": "mean", "field": "Life Expectancy World Bank", "as": "Regional_Avg"}
          ],
          "groupby": ["Region"]
        },
        {
          "calculate": "datum['Life Expectancy World Bank'] - datum.Regional_Avg",
          "as": "Difference"
        },
        {
          "window": [{"op": "row_number", "as": "rank"}],
          "sort": [{"field": "Difference", "order": "descending"}]
        },
        {
          "calculate": "if(datum.Difference > 0, 'Above Average', 'Below Average')",
          "as": "Performance"
        }
      ],
      "mark": "bar",
      "encoding": {
        "y": {
          "field": "Country Name",
          "type": "nominal",
          "title": "Country",
          "sort": {"field": "Difference", "order": "descending"}
        },
        "x": {
          "field": "Difference",
          "type": "quantitative",
          "title": "Difference from Regional Average (Years)"
        },
        "color": {
          "field": "Performance",
          "type": "nominal",
          "title": "Performance",
          "scale": {
            "domain": ["Above Average", "Below Average"],
            "range": ["#2289f4", "#de2d26"]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {"field": "Country Name", "type": "nominal", "title": "Country"},
          {"field": "Life Expectancy World Bank", "type": "quantitative", "title": "Life Expectancy", "format": ".1f"},
          {"field": "Regional_Avg", "type": "quantitative", "title": "Regional Average", "format": ".1f"},
          {"field": "Difference", "type": "quantitative", "title": "Difference", "format": "+.1f"},
          {"field": "IncomeGroup", "type": "nominal", "title": "Income Group"},
          {"field": "Year", "type": "quantitative", "title": "Year"}
        ]
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Higgo8888/FIT3179/refs/heads/main/A2%20/life_expectancy_with_coordinates.csv"
      },
      "transform": [
        {"filter": "datum.Year == Year_selection"},
        {"filter": "datum.Region == Region_selection"},
        {
          "aggregate": [
            {"op": "mean", "field": "Life Expectancy World Bank", "as": "Regional_Avg_Value"}
          ],
          "groupby": ["Region"]
        },
        {
          "calculate": "0",
          "as": "Zero_Line"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 115,
        "dy": 5,
        "fontSize": 16,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {"field": "Zero_Line", "type": "quantitative"},
        "text": {"field": "Regional_Avg_Value", "type": "quantitative", "format": ".1f"}
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/Higgo8888/FIT3179/refs/heads/main/A2%20/life_expectancy_with_coordinates.csv"
      },
      "transform": [
        {"filter": "datum.Year == Year_selection"},
        {"filter": "datum.Region == Region_selection"},
        {
          "aggregate": [
            {"op": "mean", "field": "Life Expectancy World Bank", "as": "Regional_Avg_Value"}
          ],
          "groupby": ["Region"]
        },
        {
          "calculate": "0",
          "as": "Zero_Line"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 35,
        "dy": 5,
        "fontSize": 12,
        "fontStyle": "italic"
      },
      "encoding": {
        "x": {"field": "Zero_Line", "type": "quantitative"},
        "text": {"value": "Regional Avg: "}
      }
    }
  ],
  "config": {
    "title": {
      "anchor": "start",
      "offset": 20,
      "font": "Merriweather",
      "subtitleFont": "Open Sans"
    },
    "axis": {
      "labelFont": "Open Sans",
      "titleFont": "Open Sans",
      "labelFontSize": 11,
      "titleFontSize": 13,
      "titleColor": "#34495e",
      "labelColor": "#2c3e50",
      "domainColor": "#bdc3c7",
      "domainWidth": 1
    },
    "legend": {
      "labelFont": "Open Sans",
      "titleFont": "Open Sans",
      "titleFontSize": 12,
      "labelFontSize": 11,
      "titleColor": "#2c3e50",
      "labelColor": "#34495e"
    },
    "view": {"stroke": "transparent"}
  }
}